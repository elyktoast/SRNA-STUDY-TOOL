{
  "name": "srna-source-reviewer-gateway-staging",
  "main": "src/entry.js",
  "compatibility_date": "2026-10-31",
  "vars": {
    "STAGING_ONLY": "true",
    "SUPABASE_URL": "https://xqyasyambwdyhsjkftqu.supabase.co",
    "AI_HYBRID_ENABLED": "false",
    "AI_GENERATION_CHECKPOINTS_ENABLED": "true",
    "AI_CLOUDFLARE_MODEL": "@cf/zai-org/glm-5.3",
    "AI_REWRITE_OPT_IN": "true",
    "AI_SOURCE_DISCOVERY_OPT_IN": "true",
    "AI_BLIND_REVIEW_OPT_IN": "true",
    "AI_REVIEWER_MODEL": "openai/gpt-oss-120b",
    "AI_EDITORIAL_REVIEWER_MODEL": "qwen/qwen3.8-27b",
    "AI_OPTION_REVIEW_OPT_IN": "true",
    "AI_EXPLANATION_REVIEW_OPT_IN": "true",
    "AI_AUTHORING_PROVIDER": "cloudflare",
    "STAGING_ACKNOWLEDGMENT_ENABLED": "true",
    "STAGING_PAGE_APPROVAL_ENABLED": "true",
    "AI_EMBEDDING_RELAY_OPT_IN": "true",
    "AI_SEMANTIC_EMBEDDING_OPT_IN": "true",
    "SEMANTIC_INDEX_OWNER_UID": "c003287a-10ce-4cc9-926e-ef7c3a162a26",
    "SEMANTIC_INDEX_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "SEMANTIC_INDEX_INVENTORY_PATH": "/app/canonical-semantic-inventory.json",
    "AI_REVIEWER_CALIBRATION_OPT_IN": "true",
    "AI_REVIEWER_CALIBRATION_MODEL": "openai/gpt-oss-120b",
    "AI_MC_BATCH_ENABLED": "true",
    "AI_REVIEWER_RATE_LIMIT_FALLBACK": "true"
  },
  "containers": [
    {
      "class_name": "ReviewerContainer",
      "image": "../reviewer-service/Dockerfile",
      "image_build_context": "../../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REVIEWER_CONTAINER",
        "class_name": "ReviewerContainer"
      },
      {
        "name": "MC_BATCH",
        "class_name": "McBatch"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReviewerContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "McBatch"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "SEMANTIC_AI"
  }
}
