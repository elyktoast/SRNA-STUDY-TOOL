{
  "name": "srna-source-reviewer-gateway-staging",
  "main": "src/entry.js",
  "compatibility_date": "2026-10-31",
  "vars": {
    "STAGING_ONLY": "true",
    "SUPABASE_URL": "https://xqyasyambwdyhsjkftqu.supabase.co",
    "AI_HYBRID_ENABLED": "false",
    "AI_GENERATION_CHECKPOINTS_ENABLED": "true",
    "AI_CLOUDFLARE_MODEL": "@cf/qwen/qwen3.8-27b",
    "AI_REWRITE_OPT_IN": "true",
    "AI_BLIND_REVIEW_OPT_IN": "true",
    "AI_REVIEWER_MODEL": "qwen/qwen3.8-27b",
    "AI_EDITORIAL_REVIEWER_MODEL": "openai/gpt-oss-20b",
    "AI_OPTION_REVIEW_OPT_IN": "true",
    "AI_EXPLANATION_REVIEW_OPT_IN": "true"
  },
  "containers": [
    {
      "class_name": "ReviewerContainer",
      "image": "../reviewer-service/Dockerfile",
      "image_build_context": "../../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REVIEWER_CONTAINER",
        "class_name": "ReviewerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReviewerContainer"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
