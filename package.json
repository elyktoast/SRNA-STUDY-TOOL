{
  "name": "srna-study-tool",
  "private": true,
  "scripts": {
    "validate": "node scripts/validate-repo.mjs",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/performance-budget.mjs",
    "quality": "npm run validate && npm run test:content && npm run test:revisions && npm run test:semantic && npm run test:perf",
    "test:content": "node scripts/content-integrity.mjs",
    "test:revisions": "node scripts/test-content-revisions.mjs",
    "test:semantic": "node scripts/semantic-content-audit.mjs",
    "analyze:questions": "node scripts/question-bank-analysis.mjs",
    "review:questions": "node scripts/question-review-queue.mjs",
    "review:questions:write": "node scripts/question-review-queue.mjs --write",
    "test:review-queue": "node scripts/question-review-queue.mjs --check",
    "test:cat": "node scripts/cat-simulator.mjs --runs=10 --questions=50 --check",
    "test:coverage": "node scripts/question-coverage-simulator.mjs",
    "simulate:cat": "node scripts/cat-simulator.mjs --runs=100 --questions=50 --write",
    "review:all": "node scripts/all-course-question-quality.mjs",
    "review:all:write": "node scripts/all-course-question-quality.mjs --write",
    "test:quality-report": "node scripts/test-all-course-question-quality.mjs",
    "test:ai-source": "node --test scripts/test-ai-source-*.mjs",
    "start:ai-source": "node scripts/ai-source-start-server.mjs",
    "test:studio-navigation": "node --test scripts/test-studio-manual-next.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "pdfjs-dist": "^5.4.0",
    "pg": "^8.16.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0"
  }
}
